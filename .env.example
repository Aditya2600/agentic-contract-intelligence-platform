# Copy to `.env` and generate the two token lines below. Every other value here is a
# working default: `make quickstart` runs the whole demo without any of them being
# changed, because the offline model needs no key and the memory repository needs no
# database. Real secrets are never committed -- `.env` is gitignored.
#
# Every variable the application reads is listed here. `src/doctask/config.py` is the
# authority; `tests/test_config.py` fails if the two ever drift apart.

# ---------------------------------------------------------------- storage
DOCTASK_DATABASE_URL=postgresql://doctask:doctask@localhost:5432/doctask
# memory | postgres. `memory` keeps the demo and the tests runnable with no
# infrastructure; `postgres` is the durable path, and the only one where a checkpoint
# survives a killed process (see `make demo-crash`).
DOCTASK_REPOSITORY=memory

# ------------------------------------------------------------ credentials
# Who may do what. `token:actor_id` pairs, comma separated. Reviewers are the humans
# allowed to approve, reject, and override; services are the model-facing callers, which
# may start runs and produce proposals but can never decide one. Empty means nobody
# authenticates: the API fails closed rather than open.
#
# Generate them, do not invent them:
#   printf 'DOCTASK_REVIEWER_TOKENS=%s:alice\n' "$(openssl rand -hex 24)" >> .env
#   printf 'DOCTASK_SERVICE_TOKENS=%s:ingest-bot\n' "$(openssl rand -hex 24)" >> .env
DOCTASK_REVIEWER_TOKENS=
DOCTASK_SERVICE_TOKENS=

# The credential the collection watcher presents. Must be one of the token:actor_id
# pairs already listed in DOCTASK_SERVICE_TOKENS above -- a reviewer token is refused
# outright, because a background process must never be able to advance a human gate.
# Empty means the watcher process will not start.
DOCTASK_WATCHER_TOKEN=
# Seconds between sweeps of every collection's watch_path.
DOCTASK_WATCH_INTERVAL=5
# A file larger than this is recorded as a failed attempt rather than read into memory.
DOCTASK_WATCH_MAX_FILE_BYTES=67108864

# Advertised in the MCP server's OAuth protected-resource metadata, so a client that
# gets a 401 can find out where to authenticate.
DOCTASK_MCP_ISSUER_URL=http://localhost:8000
DOCTASK_MCP_RESOURCE_SERVER_URL=http://localhost:8000

# ------------------------------------------------------------- pipeline
# Below this confidence, classification stops and asks a human instead of guessing.
DOCTASK_CLASSIFICATION_THRESHOLD=0.70
# Citation repair attempts before a candidate is abstained on rather than committed.
DOCTASK_MAX_VALIDATION_REPAIRS=1
# Evidence bound per rule evaluation. Cost scales with these, not with the corpus.
DOCTASK_RULE_CONTEXT_BLOCKS=12
DOCTASK_RULE_CONTEXT_CHARS=8000
# The declared, versioned $/million-token price table the cost report prices runs from.
# Reviewer-readable JSON, never a constant in a call site; the report states which
# version of it produced its numbers, and a model absent from it is reported as
# explicitly unpriced rather than silently free.
DOCTASK_PRICE_TABLE_PATH=config/model_prices.json

# ---------------------------------------------------------------- model
# fake | gateway. `fake` is the deterministic offline model: no API key, no GPU, no
# model server. Every test and both demos run on it.
DOCTASK_LLM=fake
DOCTASK_LLM_BASE_URL=http://localhost:8001
DOCTASK_LLM_API_KEY=
# The model id to request, as the server's `GET /v1/models` reports it.
DOCTASK_LLM_MODEL=
# Seconds before a model call is abandoned.
DOCTASK_LLM_TIMEOUT=60
# Vision model used only as OCR fallback, for PDF pages PyMuPDF could not read. Leave
# empty to run without a fallback: an unreadable page then fails the upload with a 422
# rather than being ingested as an empty page that every rule would judge on no evidence.
DOCTASK_VLM_MODEL=

# ----------------------------------------------------------------- tests
# Set to run the Postgres integration tests; `pytest` alone stays fully offline.
# DOCTASK_TEST_DATABASE_URL=postgresql://doctask:doctask@localhost:5432/doctask
